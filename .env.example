# NutriFlow — variáveis de ambiente
# Copie este arquivo para .env.local e preencha as chaves.
# Sem elas, o app roda em modo offline (localStorage).

# Supabase (veja supabase/README.md)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA (opcional — para Assistente NutriAI)
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=

# Cloudinary (opcional — para upload de fotos/anexos)
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_UPLOAD_PRESET=
